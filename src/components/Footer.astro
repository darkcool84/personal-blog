---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div>
			<p class="footer-title">{SITE_TITLE}</p>
			<p class="footer-description">{SITE_DESCRIPTION}</p>
		</div>
		<div class="footer-links">
			<a href="/blog/">전체 글</a>
			<a href="/about/">소개</a>
			<a href="/rss.xml">RSS</a>
			<a href="https://github.com/darkcool84/personal-blog" target="_blank" rel="noreferrer">GitHub</a>
		</div>
		<p class="copyright">© {today.getFullYear()} Personal Journal</p>
	</div>
</footer>

<style>
	footer {
		padding: 4rem 1.5rem;
		background: rgb(var(--black));
		color: white;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 1.3fr 1fr auto;
		gap: 3rem;
		align-items: end;
		width: min(1180px, 100%);
		margin: 0 auto;
	}

	.footer-title {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		font-weight: 700;
	}

	.footer-description {
		max-width: 480px;
		margin: 0;
		color: rgba(255, 255, 255, 55%);
		font-size: 0.7rem;
		line-height: 1.6;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem;
	}

	.footer-links a {
		color: rgba(255, 255, 255, 72%);
		font-size: 0.7rem;
		font-weight: 700;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: white;
	}

	.copyright {
		margin: 0;
		color: rgba(255, 255, 255, 42%);
		font-size: 0.62rem;
		white-space: nowrap;
	}

	@media (max-width: 780px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
			align-items: start;
		}
	}
</style>
